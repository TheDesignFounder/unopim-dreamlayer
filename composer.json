{
  "name": "dreamlayer/unopim-dreamlayer",
  "description": "Product image editing, refinement and review inside UnoPim",
  "type": "library",
  "license": "MIT",
  "version": "0.5.5",
  "require": {
    "php": "^8.2",
    "illuminate/support": "^10.0 || ^11.0 || ^12.0 || ^13.0",
    "illuminate/database": "^10.0 || ^11.0 || ^12.0 || ^13.0",
    "illuminate/queue": "^10.0 || ^11.0 || ^12.0 || ^13.0",
    "illuminate/http": "^10.0 || ^11.0 || ^12.0 || ^13.0",
    "ext-gd": "*",
    "unopim/unopim": ">=0.1.0 <4.0.0"
  },
  "autoload": {
    "psr-4": {
      "DreamLayer\\UnoPIM\\": "src/"
    }
  },
  "extra": {
    "laravel": {
      "providers": [
        "DreamLayer\\UnoPIM\\Providers\\DreamLayerServiceProvider"
      ]
    }
  },
  "archive": {
    "exclude": [
      "/tests",
      "/tools",
      "/dist",
      "/.git*",
      "/docs/*.png",
      "/docs/*.log",
      "/docs/IMPLEMENTATION_PLAN.md",
      "/docs/VERIFICATION.md",
      "/patches",
      "/NEW_USER_TEST.md"
    ]
  },
  "homepage": "https://github.com/TheDesignFounder/unopim-dreamlayer",
  "support": {
    "source": "https://github.com/TheDesignFounder/unopim-dreamlayer",
    "issues": "https://github.com/TheDesignFounder/unopim-dreamlayer/issues"
  },
  "suggest": {
    "laravel/ai": "Only needed for the optional native UnoPim chat bridge; use the version supplied by your UnoPim release."
  }
}

new file mode 100644
index 00000000..d7a93fb4
--- /dev/null
+++ b/packages/Webkul/AiAgent/src/Chat/MessageDisplay.php
@@ -0,0 +1,76 @@
+<?php
+
+namespace Webkul\AiAgent\Chat;
+
+use Illuminate\Validation\ValidationException;
+
+/** Inert native result data only: never authorization or executable tool instructions. */
+class MessageDisplay
+{
+    public function normalize(array $message): array
+    {
+        $data = array_intersect_key($message, array_flip(['result', 'product_url', 'download_url', '_confirmed', 'action']));
+        if (isset($data['result'])) {
+            if (! is_array($data['result']) || strlen(json_encode($data['result'])) > 65536) {
+                $this->invalid();
+            }
+            $nodes = 0;
+            $this->value($data['result'], 0, $nodes);
+        }
+        foreach (['product_url', 'download_url'] as $field) {
+            if (isset($data[$field]) && ! $this->safeUrl($data[$field], $field === 'product_url')) {
+                $this->invalid();
+            }
+        }
+        if (isset($data['_confirmed']) && ! is_bool($data['_confirmed'])) {
+            $this->invalid();
+        }
+        if (isset($data['action']) && (! is_string($data['action']) || ! preg_match('/^[a-zA-Z0-9_-]{1,64}$/', $data['action']))) {
+            $this->invalid();
+        }
+
+        return array_filter($data, fn ($value) => $value !== null);
+    }
+
+    private function value(mixed $value, int $depth, int &$nodes): void
+    {
+        if (++$nodes > 2048 || $depth > 8) {
+            $this->invalid();
+        }
+        if (is_array($value)) {
+            foreach ($value as $key => $child) {
+                if (strlen((string) $key) > 128 || in_array($key, ['__proto__', 'prototype', 'constructor'], true)) {
+                    $this->invalid();
+                }
+                $this->value($child, $depth + 1, $nodes);
+            }
+        } elseif (! is_null($value) && ! is_scalar($value) || is_string($value) && strlen($value) > 16384) {
+            $this->invalid();
+        }
+    }
+
+    private function safeUrl(mixed $url, bool $product): bool
+    {
+        if (! is_string($url) || strlen($url) > 8192 || (preg_match('/[\x00-\x20\x7f\\\\]/', $url) || preg_match('/[\x00-\x1f\x7f\\\\]/', rawurldecode($url)))) {
+            return false;
+        }
+        if (str_starts_with($url, '/') && ! str_starts_with(rawurldecode($url), '//')) {
+            return true;
+        }
+        $parts = parse_url($url);
+        if (! $parts || ! in_array($parts['scheme'] ?? '', ['http', 'https'], true) || empty($parts['host']) || isset($parts['user']) || isset($parts['pass'])) {
+            return false;
+        }
+        if (! $product) {
+            return true;
+        }
+        $origin = parse_url(config('app.url'));
+
+        return strtolower($parts['host']) === strtolower($origin['host'] ?? '') && $parts['scheme'] === ($origin['scheme'] ?? '') && ($parts['port'] ?? ($parts['scheme'] === 'https' ? 443 : 80)) === ($origin['port'] ?? (($origin['scheme'] ?? '') === 'https' ? 443 : 80));
+    }
+
+    private function invalid(): never
+    {
+        throw ValidationException::withMessages(['messages' => trans('ai-agent::app.common.invalid-data')]);
+    }
+}
diff --git a/packages/Webkul/AiAgent/src/Chat/ResultRendererRegistry.php b/packages/Webkul/AiAgent/src/Chat/ResultRendererRegistry.php
new file mode 100644
index 00000000..237eaba0
--- /dev/null
+++ b/packages/Webkul/AiAgent/src/Chat/ResultRendererRegistry.php
@@ -0,0 +1,57 @@
+<?php
+
+namespace Webkul\AiAgent\Chat;
+
+/**
+ * Only installed server code registers component/view names. Descriptors are inert references.
+ *
+ * @phpstan-type RendererRegistration array{component: string, view: string, consumesContext: string|null}
+ * @phpstan-type ResultDescriptor array{type: string, id: string}
+ */
+class ResultRendererRegistry
+{
+    /** @var array<string, RendererRegistration> */
+    private array $renderers = [];
+
+    /** Register trusted component/view names and an optional composer context to clear. */
+    public function register(string $type, string $component, string $view, ?string $consumesContext = null): void
+    {
+        if (! preg_match('/^[a-z][a-z0-9.-]{0,63}$/D', $type)
+            || ! preg_match('/^v-[a-z0-9-]{1,125}$/D', $component)
+            || ($consumesContext !== null && ! preg_match('/^[a-z][a-z0-9._-]{0,63}$/D', $consumesContext))) {
+            throw new \InvalidArgumentException('Invalid result renderer registration.');
+        }
+        $this->renderers[$type] = compact('component', 'view', 'consumesContext');
+    }
+
+    /** @return array<string, string> */
+    public function components(): array
+    {
+        return array_map(fn ($r) => $r['component'], $this->renderers);
+    }
+
+    /** @return array<string, string> */
+    public function contextConsumers(): array
+    {
+        return array_filter(array_map(fn ($r) => $r['consumesContext'], $this->renderers));
+    }
+
+    /** @return array<int, string> */
+    public function views(): array
+    {
+        return array_unique(array_column($this->renderers, 'view'));
+    }
+
+    /** @return ResultDescriptor|null An inert reference; the renderer authorizes access. */
+    public function descriptor(mixed $value): ?array
+    {
+        if (! is_array($value) || count($value) !== 2
+            || ! is_string($value['type'] ?? null) || ! is_string($value['id'] ?? null)
+            || ! preg_match('/^[a-z][a-z0-9.-]{0,63}$/D', $value['type'])
+            || ! preg_match('/^[A-Za-z0-9_-]{1,64}$/D', $value['id'])) {
+            return null;
+        }
+
+        return ['type' => $value['type'], 'id' => $value['id']];
+    }
+}

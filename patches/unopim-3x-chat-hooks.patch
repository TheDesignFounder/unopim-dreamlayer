+// getRandomValues also works on self-hosted HTTP origins where randomUUID is unavailable.
+const chatRequestId = () => {
+    const bytes = crypto.getRandomValues(new Uint8Array(16));
+    bytes[6] = (bytes[6] & 15) | 64;

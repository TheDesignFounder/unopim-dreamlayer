diff --git a/packages/Webkul/AiAgent/tests/Feature/AgentRunnerPartialResultTest.php b/packages/Webkul/AiAgent/tests/Feature/AgentRunnerPartialResultTest.php
new file mode 100644
index 00000000..06ae1fdf
--- /dev/null
+++ b/packages/Webkul/AiAgent/tests/Feature/AgentRunnerPartialResultTest.php
@@ -0,0 +1,76 @@
+<?php
+
+use Illuminate\Support\Facades\Http;
+use Laravel\Ai\AnonymousAgent;
+use Laravel\Ai\Responses\Data\Meta;
+use Laravel\Ai\Responses\Data\ToolResult;
+use Laravel\Ai\Responses\StreamableAgentResponse;
+use Laravel\Ai\Streaming\Events\TextDelta;
+use Laravel\Ai\Streaming\Events\ToolResult as ToolResultEvent;
+use Webkul\AiAgent\Chat\AgentRunner;
+use Webkul\AiAgent\Chat\ChatContext;
+use Webkul\AiAgent\Chat\ToolRegistry;
+use Webkul\MagicAI\Models\MagicAIPlatform;
+use Webkul\User\Models\Admin;
+
+it('delivers completed tool references before an observer can interrupt the stream', function (bool $observerFails) {
+    Http::preventStrayRequests();
+    $descriptor = ['type' => 'example.lookup', 'id' => 'existing-result'];
+    $stream = new StreamableAgentResponse('fixture', function () use ($descriptor) {
+        yield new ToolResultEvent('tool-event', new ToolResult(
+            'tool-call', 'example_lookup', [], json_encode(['presentation' => $descriptor, 'mutated' => false]),
+        ), true, null, time());
+        yield new TextDelta('text-event', 'reply', 'Existing result ready.', time());
+    }, new Meta('openai', 'fixture-model'));
+    if ($observerFails) {
+        // Debugbar's incompatible usage collector throws here, after tool work
+        // completed. Keep the regression independent of that optional package.
+        $stream->then(fn () => throw new RuntimeException('Completion observer failed'));
+    }
+    $agent = Mockery::mock(AnonymousAgent::class);
+    $agent->shouldReceive('stream')->once()->andReturn($stream);
+    $runner = new class(resolve(ToolRegistry::class), $agent) extends AgentRunner
+    {
+        public function __construct(ToolRegistry $registry, private AnonymousAgent $fixture)
+        {
+            parent::__construct($registry);
+        }
+
+        protected function buildAgent(ChatContext $context): AnonymousAgent
+        {
+            return $this->fixture;
+        }
+
+        protected function disableOutputBuffering(): void {}
+    };
+    $admin = Admin::factory()->create();
+    $context = new ChatContext(
+        message: 'Show an existing result', history: [], productId: null, productSku: null, productName: null,
+        locale: 'en_US', channel: 'default',
+        platform: new MagicAIPlatform(['provider' => 'openai', 'api_key' => 'fixture-only']),
+        model: 'fixture-model', user: $admin,
+    );
+    ob_start();
+    $runner->runStreaming($context)->sendContent();
+    $output = (string) ob_get_clean();
+    preg_match('/event: tool_result\ndata: (.+)\n/', $output, $match);
+    expect($match)->not->toBeEmpty();
+    $receipt = json_decode($match[1], true);
+    expect($receipt['presentation'])->toBe($descriptor);
+    if ($observerFails) {
+        expect($output)->toContain('event: error')->not->toContain('event: complete');
+        expect(strpos($output, 'event: tool_result'))->toBeLessThan(strpos($output, 'event: error'));
+    } else {
+        expect($output)->toContain('event: complete')->not->toContain('event: error');
+    }
+
+    // Exercise real owner-scoped persistence independently of browser storage.
+    $this->actingAs($admin, 'admin');
+    $saved = $this->postJson(route('ai-agent.conversations.store'), [
+        'conversation_id' => 'history-fixture', 'title' => 'Saved result',
+        'messages'        => [['role' => 'assistant', 'content' => 'Result available', 'message_id' => 'reply-1', 'presentation' => $receipt['presentation']]],
+    ])->assertOk();
+    $this->getJson(route('ai-agent.conversations.show', $saved->json('id')))
+        ->assertOk()->assertJsonPath('messages.0.presentation', $descriptor);
+    Http::assertNothingSent();
+})->with(['observer disabled' => false, 'observer throws after result' => true]);
diff --git a/packages/Webkul/AiAgent/tests/JavaScript/history-stream.test.cjs b/packages/Webkul/AiAgent/tests/JavaScript/history-stream.test.cjs
new file mode 100644
index 00000000..0bc46aec
--- /dev/null
+++ b/packages/Webkul/AiAgent/tests/JavaScript/history-stream.test.cjs
@@ -0,0 +1,41 @@
+const test = require('node:test');
+const assert = require('node:assert/strict');
+const {widget} = require('./widget-harness.cjs');
+
+const descriptor = {type: 'example.lookup', id: 'saved-result'};
+const result = {presentation: descriptor, result: {status: 'ready'}};
+const frame = (type, data) => `event: ${type}\ndata: ${JSON.stringify(data)}\n\n`;
+
+for (const ending of ['complete', 'observer-error', 'connection-error']) {
+    test(`completed tool result survives ${ending} and is included in saved history`, async () => {
+        const {widget: w} = widget([], {TextDecoder});
+        let saved;
+        w.activeSessionId = 'history-fixture';
+        w.scrollBottom = w.persistSessions = () => {};
+        w.$axios = {post: async (url, payload) => { saved = JSON.parse(JSON.stringify(payload)); return {data: {id: 1}}; }};
+        let reads = 0;
+        const response = {body: {getReader: () => ({read: async () => {
+            if (reads++ === 0) return {done: false, value: new TextEncoder().encode(frame('tool_result', result))};
+            if (ending === 'connection-error') throw Error('Connection closed after the tool returned');
+            if (reads === 2) return {done: false, value: new TextEncoder().encode(ending === 'complete'
+                ? frame('complete', {action: 'agent_response'})
+                : frame('error', {message: 'A completion observer failed.'}))};
+            return {done: true};
+        }})}};
+        await w.processStream(response, []);
+        await w.saveCurrentSession();
+        assert.deepEqual(saved.messages[0].presentation, descriptor);
+        const reopened = widget().widget.mergeHistory(saved.messages);
+        assert.deepEqual(JSON.parse(JSON.stringify(reopened[0].presentation)), descriptor);
+        if (ending === 'observer-error') assert.equal(reopened[0].content, 'A completion observer failed.');
+    });
+}
+
+test('an error before any completed tool does not invent a result or redirect', async () => {
+    const {widget: w} = widget([], {TextDecoder});
+    w.scrollBottom = () => {};
+    w.shouldAutoRefreshAfterAction = () => { throw Error('Failed streams must not refresh the page'); };
+    await w.processStream(new Response(frame('error', {message: 'No result was produced.'})), []);
+    assert.equal(w.messages[0].presentation, null);
+    assert.equal(w.messages[0].content, 'No result was produced.');
+});
